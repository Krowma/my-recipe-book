{
  "expo": {
    "name": "My Recipes",
    "slug": "my-recipe-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appIcon/app-icon.png",
    "scheme": "myrecipebook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
        "adaptiveIcon": {
            "backgroundColor": "#faf0e6",
            "foregroundImage": "./assets/images/appIcon/app-icon-foreground.png",
            "monochromeImage": "./assets/images/appIcon/app-icon-foreground.png"
        },
        "predictiveBackGestureEnabled": false,
        "package": "com.krowma.myrecipebook"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf0e6",
          "android": {
            "image": "./assets/images/appIcon/splash-icon-foreground.png",
            "imageWidth": 150,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
